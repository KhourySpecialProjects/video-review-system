# Copy to .env.glitchtip (gitignored) for LOCAL GlitchTip, or set these in the
# Coolify resource. Consumed by docker-compose.glitchtip.yml.

# Long random string — generate with:  openssl rand -base64 50
GLITCHTIP_SECRET_KEY=

# Password for GlitchTip's OWN Postgres (unrelated to the app's DB).
GLITCHTIP_DB_PASSWORD=

# Public URL of this GlitchTip instance.
#   Local:   http://localhost:8000
#   Coolify: https://glitchtip.cs4535.cloud   (match the domain you set on gt-web)
GLITCHTIP_DOMAIN=http://localhost:8000

# Optional. Local default (consolemail://) prints emails to the worker log.
# GLITCHTIP_FROM_EMAIL=glitchtip@localhost
# GLITCHTIP_EMAIL_URL=consolemail://
