# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=angelman

# ── Backend ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@postgres:5432/angelman?sslmode=disable
DIRECT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/angelman?sslmode=disable
ALLOWED_ORIGIN=https://localhost:3000
PORT=8080

BETTER_AUTH_SECRET=<generate with: openssl rand -base64 32>
BETTER_AUTH_URL=http://localhost:3000
ADMIN_SECRET=<generate with: openssl rand -base64 32>

# ── Frontend ────────────────────────────────────────────────────────────────

# ── Fully-local dev (no AWS) ─────────────────────────────────────────────────
# For running everything against a local Docker Postgres with no AWS Secrets
# Manager / RDS / SSM. See the "Local development (no AWS)" section of README.md.
# When LOCAL=true, prisma.ts uses LOCAL_DATABASE_URL and disables pg SSL.
#
# LOCAL=true
# LOCAL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/angelman
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/angelman
# NODE_ENV=development
# PORT=3000                                # must match the Vite dev proxy (frontend/vite.config.ts)
# ALLOWED_ORIGIN=https://localhost:5173
# FRONTEND_URL=https://localhost:5173
# LOG_LEVEL=info
# INTERNAL_SECRET_HEADER=local-internal-secret
# ADMIN_SECRET=local-admin-secret
# AWS_REGION=us-east-1
# BETTER_AUTH_SECRET=<generate with: openssl rand -base64 32>
# BETTER_AUTH_URL=http://localhost:3000
